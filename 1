#!/bin/bash

# Função para pausar e garantir que o terminal responda
pause() {
    # Reseta as configurações do terminal para garantir que o input funcione
    stty sane
    echo -e "\n\e[1;33m[CONCLUÍDO] Pressione [ENTER] para voltar ao menu...\e[0m"
    # Lê do terminal ignorando qualquer lixo no buffer
    read -r _ < /dev/tty
}

# Funções de Instalação
do_prep() {
    clear
    loadkeys br-abnt2 && timedatectl set-ntp true
    sed -i '/\[multilib\]/,/Include/s/^#//' /etc/pacman.conf
    
    echo -e "\n\e[1;32m[BUSCANDO OS MELHORES MIRRORS DO BRASIL...]\e[0m"
    reflector --country Brazil --latest 15 --protocol https --sort age --save /etc/pacman.d/mirrorlist
    
    echo -e "\n\e[1;34m--- Lista de Mirrors Gerada ---\e[0m"
    grep "^Server" /etc/pacman.d/mirrorlist
    echo -e "\e[1;34m-------------------------------\e[0m"
    
    echo -e "\nSincronizando base de dados..."
    pacman -Sy
    pause
}

do_disk() {
    clear
    lsblk -d -o NAME,SIZE,MODEL
    echo ""
    echo -n "Digite o nome do disco (ex: sda ou nvme0n1): "
    read -r DISK_NAME < /dev/tty
    DISK="/dev/$DISK_NAME"
    [[ $DISK == *"nvme"* ]] && PART_SUFFIX="p" || PART_SUFFIX=""
    
    echo "Limpando assinaturas antigas e particionando $DISK..."
    wipefs -a $DISK
    echo 'label: gpt
    size=512M, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
    type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709' | sfdisk $DISK
    
    echo "Formatando e montando partições..."
    mkfs.fat -F 32 ${DISK}${PART_SUFFIX}1
    mkfs.ext4 ${DISK}${PART_SUFFIX}2
    mount ${DISK}${PART_SUFFIX}2 /mnt
    mount --mkdir ${DISK}${PART_SUFFIX}1 /mnt/boot
    
    echo "DISK=$DISK" > /tmp/inst_vars
    echo "PART_SUFFIX=$PART_SUFFIX" >> /tmp/inst_vars
    pause
}

do_pacstrap() {
    clear
    case $1 in
        base)   pacstrap -K /mnt base linux linux-firmware base-devel networkmanager nano git ;;
        nvidia) pacstrap -K /mnt nvidia-open nvidia-utils nvidia-settings lib32-nvidia-utils ;;
        gnome)  pacstrap -K /mnt gnome gnome-extra gdm xorg-xwayland steam ;;
    esac
    pause
}

do_config() {
    clear
    if [ ! -f /tmp/inst_vars ]; then
        echo "Erro: Você precisa configurar o disco (opção 2) primeiro!"
        pause
        return
    fi
    source /tmp/inst_vars
    genfstab -U /mnt >> /mnt/etc/fstab
    ROOT_UUID=$(blkid -s UUID -o value ${DISK}${PART_SUFFIX}2)
    
    arch-chroot /mnt /bin/bash <<EOF
    ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
    hwclock --systohc
    sed -i 's/#pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/' /etc/locale.gen
    locale-gen
    echo 'LANG=pt_BR.UTF-8' > /etc/locale.conf
    echo 'KEYMAP=br-abnt2' > /etc/vconsole.conf
    echo 'arch-pc' > /etc/hostname
    sed -i 's/MODULES=(/MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm /' /etc/mkinitcpio.conf
    mkinitcpio -P
    bootctl install
    echo -e "title Arch Linux\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions root=UUID=$ROOT_UUID rw nvidia-drm.modeset=1" > /boot/loader/entries/arch.conf
    echo -e "default arch.conf\ntimeout 1\nconsole-mode max" > /boot/loader/loader.conf
    sed -i 's/# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
    systemctl enable NetworkManager gdm
EOF
    echo -e "\n\e[1;33m--- DEFINA A SENHA DO USUÁRIO ROOT ---\e[0m"
    arch-chroot /mnt passwd
    pause
}

do_user() {
    clear
    echo -n "Digite o nome do novo usuário: "
    read -r USER_NAME < /dev/tty
    arch-chroot /mnt useradd -m -G wheel -s /bin/bash "$USER_NAME"
    echo -e "\n\e[1;33m--- DEFINA A SENHA PARA $USER_NAME ---\e[0m"
    arch-chroot /mnt passwd "$USER_NAME"
    pause
}

# Loop Principal
while true; do
    CHOICE=$(whiptail --title "Arch Linux Installer" --menu "Selecione a tarefa:" 20 65 9 \
        "1" "Preparar Mirrors (BR) e Teclado" \
        "2" "Particionar e Montar Discos" \
        "3" "Pacstrap: Base (Kernel + Redes)" \
        "4" "Pacstrap: Drivers NVIDIA" \
        "5" "Pacstrap: GNOME + Steam" \
        "6" "Configurar Sistema e Bootloader" \
        "7" "Criar Usuário e Senhas" \
        "8" "Finalizar e Reiniciar" 3>&1 1>&2 2>&3)

    case $CHOICE in
        1) do_prep ;;
        2) do_disk ;;
        3) do_pacstrap base ;;
        4) do_pacstrap nvidia ;;
        5) do_pacstrap gnome ;;
        6) do_config ;;
        7) do_user ;;
        8) 
            if whiptail --yesno "Deseja desmontar /mnt e reiniciar agora?" 8 45; then
                rm -f /tmp/inst_vars
                umount -R /mnt && reboot
            else
                continue
            fi
            ;;
        *) 
            rm -f /tmp/inst_vars
            exit 
            ;;
    esac
done
