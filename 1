#!/bin/bash

# Funções de Instalação
do_prep() {
    loadkeys br-abnt2 && timedatectl set-ntp true
    sed -i '/\[multilib\]/,/Include/s/^#//' /etc/pacman.conf
    
    echo "Buscando os mirrors mais atualizados do Brasil..."
    # Aumentado para 15 mirrors e ordenado por 'age' para evitar erros de timeout no teste de velocidade
    reflector --country Brazil --latest 15 --protocol https --sort age --save /etc/pacman.d/mirrorlist
    
    pacman -Sy
}

do_disk() {
    lsblk -d -o NAME,SIZE,MODEL
    read -p "Digite o nome do disco (ex: sda ou nvme0n1): " DISK_NAME
    DISK="/dev/$DISK_NAME"
    [[ $DISK == *"nvme"* ]] && PART_SUFFIX="p" || PART_SUFFIX=""
    
    echo "Limpando e particionando $DISK..."
    wipefs -a $DISK
    echo 'label: gpt
    size=512M, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
    type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709' | sfdisk $DISK
    
    mkfs.fat -F 32 ${DISK}${PART_SUFFIX}1
    mkfs.ext4 ${DISK}${PART_SUFFIX}2
    mount ${DISK}${PART_SUFFIX}2 /mnt
    mount --mkdir ${DISK}${PART_SUFFIX}1 /mnt/boot
    
    # Persistência de variáveis para as próximas etapas
    echo "DISK=$DISK" > /tmp/inst_vars
    echo "PART_SUFFIX=$PART_SUFFIX" >> /tmp/inst_vars
}

do_config() {
    if [ ! -f /tmp/inst_vars ]; then
        whiptail --msgbox "Erro: Execute a etapa de disco (2) primeiro!" 8 45
        return
    fi
    source /tmp/inst_vars
    genfstab -U /mnt >> /mnt/etc/fstab
    ROOT_UUID=$(blkid -s UUID -o value ${DISK}${PART_SUFFIX}2)
    
    arch-chroot /mnt /bin/bash <<EOF
    ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
    hwclock --systohc
    sed -i 's/#pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/' /etc/locale.gen
    locale-gen
    echo 'LANG=pt_BR.UTF-8' > /etc/locale.conf
    echo 'KEYMAP=br-abnt2' > /etc/vconsole.conf
    echo 'arch-pc' > /etc/hostname
    sed -i 's/MODULES=(/MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm /' /etc/mkinitcpio.conf
    mkinitcpio -P
    bootctl install
    echo -e "title Arch Linux\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions root=UUID=$ROOT_UUID rw nvidia-drm.modeset=1" > /boot/loader/entries/arch.conf
    echo -e "default arch.conf\ntimeout 1\nconsole-mode max" > /boot/loader/loader.conf
    sed -i 's/# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
    systemctl enable NetworkManager gdm
EOF
    echo -e "\n--- Defina a senha do ROOT ---"
    arch-chroot /mnt passwd
}

do_user() {
    echo "Nome do usuário:"
    read -r USER_NAME
    arch-chroot /mnt useradd -m -G wheel -s /bin/bash "$USER_NAME"
    echo "Defina a senha para $USER_NAME:"
    arch-chroot /mnt passwd "$USER_NAME"
}

# Loop Principal com Whiptail
while true; do
    CHOICE=$(whiptail --title "Arch Linux Installer (Mirrors BR)" --menu "Escolha uma etapa:" 20 65 9 \
        "1" "Preparar Mirrors (Brasil) e Teclado" \
        "2" "Particionar e Montar Discos" \
        "3" "Pacstrap: Base (Kernel + Redes)" \
        "4" "Pacstrap: Drivers NVIDIA" \
        "5" "Pacstrap: GNOME + Steam" \
        "6" "Configurar Sistema e Bootloader" \
        "7" "Criar Usuário e Senhas" \
        "8" "Finalizar e Reiniciar" 3>&1 1>&2 2>&3)

    case $CHOICE in
        1) do_prep ;;
        2) do_disk ;;
        3) pacstrap -K /mnt base linux linux-firmware base-devel networkmanager nano git ;;
        4) pacstrap -K /mnt nvidia-open nvidia-utils nvidia-settings lib32-nvidia-utils ;;
        5) pacstrap -K /mnt gnome gnome-extra gdm xorg-xwayland steam ;;
        6) do_config ;;
        7) do_user ;;
        8) 
            if whiptail --yesno "Desmontar /mnt e reiniciar agora?" 8 45; then
                rm -f /tmp/inst_vars
                umount -R /mnt && reboot
            else
                break
            fi
            ;;
        *) 
            rm -f /tmp/inst_vars
            exit 
            ;;
    esac
done

# Limpeza caso o script seja fechado com CTRL+C
rm -f /tmp/inst_vars
