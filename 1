#!/bin/bash

export NEWT_COLORS='root=,black; window=,white; border=black,white; title=blue,white; button=black,cyan; actbutton=white,blue; listbox=black,white; actlistbox=white,blue'

CLR_RESET="\e[0m"
CLR_YELLOW="\e[1;33m"
CLR_GREEN="\e[1;32m"
CLR_WHITE="\e[1;37m"
CLR_BLUE="\e[1;34m"
CLR_RED="\e[1;31m"
CLR_CYAN="\e[1;36m"

INFO="${CLR_CYAN}󰋼${CLR_RESET}"
SUCCESS="${CLR_GREEN}[OK]${CLR_RESET}"
WARNING="${CLR_YELLOW}[!]${CLR_RESET}"
DANGER="${CLR_RED}[X]${CLR_RESET}"
NEXT="${CLR_BLUE}➜${CLR_RESET}"

pause() {
    stty sane
    echo -e "\n${CLR_YELLOW}Press [ENTER] to continue...${CLR_RESET}"
    read -r _ < /dev/tty
}

confirm() {
    local cmd="$1"
    echo -e "\n${NEXT} ${CLR_YELLOW}NEXT COMMAND:${CLR_RESET} ${CLR_WHITE}$cmd${CLR_RESET}"
    echo -ne "${CLR_GREEN}[ENTER]${CLR_RESET} Run | ${CLR_RED}[N]${CLR_RESET} Skip: "
    read -r user_input < /dev/tty
    if [[ "$user_input" =~ ^[Nn]$ ]]; then
        echo -e "${DANGER} ${CLR_RED}[SKIPPED]${CLR_RESET}"
    else
        eval "$cmd"
    fi
}

do_prep_net() {
    clear
    confirm "loadkeys br-abnt2"
    confirm "timedatectl set-ntp true"
    pause
}

do_prep_mirrors() {
    clear
    confirm "sed -i '/\[multilib\]/,/Include/s/^#//' /etc/pacman.conf"
    echo -e "${SUCCESS} ${CLR_GREEN}[REFRESHING MIRRORS]${CLR_RESET}"
    confirm "reflector --country Brazil --latest 10 --protocol https --sort age --save /etc/pacman.d/mirrorlist"
    echo -e "\n${INFO} ${CLR_BLUE}MIRRORLIST:${CLR_RESET}"
    cat /etc/pacman.d/mirrorlist
    confirm "pacman -Sy"
    pause
}

do_disk_setup() {
    clear
    lsblk -d -o NAME,SIZE,MODEL
    echo -n "Disk name (e.g. sda or nvme0n1): "
    read -r DISK_NAME < /dev/tty
    DISK="/dev/$DISK_NAME"
    [[ $DISK == *"nvme"* ]] && PART_SUFFIX="p" || PART_SUFFIX=""
    
    confirm "wipefs -a $DISK"
    confirm "echo -e 'label: gpt\nsize=512M, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B\ntype=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709' | sfdisk $DISK"
    echo "DISK=$DISK" > /tmp/inst_vars
    echo "PART_SUFFIX=$PART_SUFFIX" >> /tmp/inst_vars
    pause
}

do_disk_mount() {
    clear
    source /tmp/inst_vars
    confirm "mkfs.fat -F 32 ${DISK}${PART_SUFFIX}1"
    confirm "mkfs.ext4 ${DISK}${PART_SUFFIX}2"
    confirm "mount ${DISK}${PART_SUFFIX}2 /mnt"
    confirm "mount --mkdir ${DISK}${PART_SUFFIX}1 /mnt/boot"
    pause
}

do_pacstrap() {
    clear
    local base_sys="base linux linux-firmware base-devel networkmanager nano git zsh zsh-autosuggestions"
    local video="nvidia-open nvidia-utils nvidia-settings lib32-nvidia-utils"
    local games="steam"
    local desktop="gnome gdm xorg-xwayland epiphany gnome-tweaks flatpak"
    local tools="file-roller gnome-disk-utility gnome-system-monitor bluez bluez-utils pipewire-pulse pavucontrol wget curl fastfetch"
    local pkgs="$base_sys $video $games $desktop $tools"
    echo -e "${INFO} ${CLR_CYAN}[INSTALLING PACKAGES]${CLR_RESET}"
    confirm "pacstrap -K /mnt $pkgs"
    pause
}

do_config_system() {
    clear
    source /tmp/inst_vars
    confirm "genfstab -U /mnt >> /mnt/etc/fstab"
    confirm "arch-chroot /mnt ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime"
    confirm "arch-chroot /mnt hwclock --systohc"
    confirm "arch-chroot /mnt sed -i 's/#pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/' /etc/locale.gen"
    confirm "arch-chroot /mnt locale-gen"
    confirm "arch-chroot /mnt bash -c \"echo 'LANG=pt_BR.UTF-8' > /etc/locale.conf\""
    confirm "arch-chroot /mnt bash -c \"echo 'KEYMAP=br-abnt2' > /etc/vconsole.conf\""
    confirm "arch-chroot /mnt localectl set-x11-keymap br"
    confirm "arch-chroot /mnt bash -c \"echo 'arch-pc' > /etc/hostname\""
    pause
}

do_hardware() {
    clear
    confirm "arch-chroot /mnt sed -i 's/MODULES=(/MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm /' /etc/mkinitcpio.conf"
    confirm "arch-chroot /mnt mkinitcpio -P"
    confirm "arch-chroot /mnt systemctl enable NetworkManager gdm"
    pause
}

do_bootloader() {
    clear
    source /tmp/inst_vars
    ROOT_UUID=$(blkid -s UUID -o value ${DISK}${PART_SUFFIX}2)
    confirm "arch-chroot /mnt bootctl install"
    confirm "arch-chroot /mnt bash -c \"echo -e 'title Arch Linux\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions root=UUID=$ROOT_UUID rw nvidia-drm.modeset=1' > /boot/loader/entries/arch.conf\""
    confirm "arch-chroot /mnt bash -c \"echo -e 'default arch.conf\ntimeout 1\nconsole-mode max' > /boot/loader/loader.conf\""
    pause
}

do_root_pass() {
    clear
    echo -e "\n${DANGER} ${CLR_RED}[ ROOT PASSWORD CONFIGURATION ]${CLR_RESET}"
    echo -e "${CLR_WHITE}Set password for the ROOT user:${CLR_RESET}"
    arch-chroot /mnt passwd < /dev/tty
    pause
}

do_create_user() {
    clear
    confirm "arch-chroot /mnt sed -i 's/# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers"
    
    echo -ne "${INFO} ${CLR_WHITE}Enter new username: ${CLR_RESET}"
    read -r USER_NAME < /dev/tty
    confirm "arch-chroot /mnt useradd -m -G wheel -s /bin/zsh $USER_NAME"
    confirm "arch-chroot /mnt sudo -u $USER_NAME dbus-run-session gsettings set org.gnome.desktop.input-sources sources \"[('xkb', 'br')]\""
    confirm "arch-chroot /mnt bash -c \"[ -f /etc/zsh/zshrc ] && cp /etc/zsh/zshrc /home/$USER_NAME/.zshrc || touch /home/$USER_NAME/.zshrc\""
    confirm "arch-chroot /mnt bash -c \"echo 'source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh' >> /home/$USER_NAME/.zshrc\""
    confirm "arch-chroot /mnt chown -R $USER_NAME:$USER_NAME /home/$USER_NAME"
    
    echo -e "\n${NEXT} ${CLR_CYAN}Set password for $USER_NAME:${CLR_RESET}"
    arch-chroot /mnt passwd "$USER_NAME" < /dev/tty
    pause
}

do_reboot() {
    clear
    echo -e "${WARNING} ${CLR_YELLOW}--- FINALIZING ---${CLR_RESET}"
    echo -e "${INFO} ${CLR_WHITE}Installation is complete.${CLR_RESET}"
    echo -e "${INFO} ${CLR_CYAN}IMPORTANT: Remove the USB drive when the screen goes black.${CLR_RESET}"
    
    if whiptail --title " Reboot System " --yesno "Would you like to reboot now?\n\nRemember to remove the USB drive during boot." 10 50; then
        echo -e "\n${NEXT} Unmounting file systems..."
        rm -f /tmp/inst_vars
        umount -R /mnt
        echo -e "${SUCCESS} All set. Rebooting in 3 seconds..."
        sleep 3
        reboot
    fi
}

while true; do
    CHOICE=$(whiptail --title " ARCH LINUX MODULAR INSTALLER " --menu "Progress Map:" 20 65 11 \
        "1" "󰌌  Step 1: Keys & Time" \
        "2" "󰏖  Step 2: Mirrors" \
        "3" "󰋊  Step 3: Partitioning" \
        "4" "󰒋  Step 4: Format & Mount" \
        "5" "󰏖  Step 5: Pacstrap Install" \
        "6" "󰒓  Step 6: System & Locale" \
        "7" "󰈐  Step 7: Drivers & Services" \
        "8" "󰜉  Step 8: Bootloader Setup" \
        "9" "󰀉  Step 9: Set Root Password" \
        "10" "󰀉  Step 10: Create User Account" \
        "11" "󰜉  Step 11: Finalize & Reboot" 3>&1 1>&2 2>&3)

    case $CHOICE in
        1) do_prep_net ;;
        2) do_prep_mirrors ;;
        3) do_disk_setup ;;
        4) do_disk_mount ;;
        5) do_pacstrap ;;
        6) do_config_system ;;
        7) do_hardware ;;
        8) do_bootloader ;;
        9) do_root_pass ;;
        10) do_create_user ;;
        11) do_reboot ;;
        *) exit ;;
    esac
done
